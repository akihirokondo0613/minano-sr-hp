RewriteEngine On

# トップページの重複URLを正規URLへ統一する。
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ https://minano-sr.com/ [R=301,L,NE]

# 独自SSLを利用するすべての公開ページをHTTPSへ統一する。
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://minano-sr.com%{REQUEST_URI} [R=301,L,NE]

# スポット注文システムは 2026-09-12 に撤去（メール・電話でのご依頼に一本化）。古いリンクは料金ページへ。
RewriteRule ^spot\.html$ https://minano-sr.com/pricing.html [R=301,L,NE]
RewriteRule ^tokutei\.html$ https://minano-sr.com/pricing.html [R=301,L,NE]
RewriteRule ^go(/.*)?$ https://minano-sr.com/pricing.html [R=301,L,NE]
