RewriteEngine On

# トップページの重複URLを正規URLへ統一する。
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ https://minano-sr.com/ [R=301,L,NE]

# 独自SSLを利用するすべての公開ページをHTTPSへ統一する。
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://minano-sr.com%{REQUEST_URI} [R=301,L,NE]

# スポット注文システムは 2026-09-12 に撤去（メール・電話でのご依頼に一本化）。古いリンクは料金ページへ。
RewriteRule ^spot\.html$ https://minano-sr.com/pricing.html [R=301,L,NE]
RewriteRule ^tokutei\.html$ https://minano-sr.com/pricing.html [R=301,L,NE]
RewriteRule ^go(/.*)?$ https://minano-sr.com/pricing.html [R=301,L,NE]

# 入社書類セットの一括ZIPは 2026-10-18 に配布終了（本人判断「不要」）。個別ファイルの一覧へ。
RewriteRule ^assets/download/onboarding-kit\.zip$ https://minano-sr.com/shoshiki.html#onboarding-kit [R=301,L,NE]

# 2026-08 に取り下げた開業準備の5記事。404 のままだと Google が何度も取りに来るので、
# 「意図して消した」を意味する 410 を返す（代わりのページが無いのでリダイレクトはしない）。
RewriteRule ^blog/dns-mail-authentication\.html$ - [R=410,L]
RewriteRule ^blog/google-business-profile-kaisetsu\.html$ - [R=410,L]
RewriteRule ^blog/google-workspace-dokujidomain-mail\.html$ - [R=410,L]
RewriteRule ^blog/kaigyo-domain-shutoku\.html$ - [R=410,L]
RewriteRule ^blog/website-search-console-kokai\.html$ - [R=410,L]

# ===== 簡素トップモード: トップ以外はトップへ（公開工程が自動で付与） =====
# ファイル（画像・CSS・JS・PDF・ZIP・txt・xml 等）はそのまま配信し、ページ要求だけをトップへ返す。
# 上の 410（取り下げ記事）は [L] で先に確定するので対象外。顧問先向けの書式ページ /shoshiki.html と /shoshiki/ も対象外。
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} !^/shoshiki\.html$
RewriteCond %{REQUEST_URI} !^/shoshiki/
RewriteCond %{REQUEST_URI} !\.(css|js|mjs|json|xml|txt|ico|png|jpe?g|gif|webp|avif|svg|woff2?|ttf|pdf|zip|csv|mp4|webm|vtt)$ [NC]
RewriteRule ^ / [R=302,L]
# ===== 簡素トップモード ここまで =====
